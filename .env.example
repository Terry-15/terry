# Copier ce fichier en .env.local puis renseigner les valeurs du projet Supabase.
# Tant que ces variables sont absentes, l'application démarre en mode démonstration
# avec un jeu de données fictives en mémoire.

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
